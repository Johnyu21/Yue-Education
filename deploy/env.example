# =============================================================
# 服务器数据库配置（把这个文件名改成 .env）
# =============================================================
# 用法：本文件放在和 docker-compose.云端.yml 同一目录
#      ⚠️ 文件名必须叫 .env（前面有个点）

POSTGRES_USER=postgres
POSTGRES_PASSWORD=在这里换成强密码
POSTGRES_DB=education

# 队友要直连服务器的数据库时，取消下一行注释（同时改安全组）
# DB_BIND=0.0.0.0
