# =============================================================
# .gitignore —— 不该提交到 git 的东西
# =============================================================

# ---- 前端 ----
node_modules/
dist/
.vite/

# ---- 敏感配置（含密码）----
.env
.env.*
!.env.example

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---- 日志（运行生成）----
logs/
*.log

# ---- 上传的文件（运行生成）----
uploads/
storage/

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- 数据库本地数据（如有）----
*.sqlite3
pgdata/

*.credentials.txt
backups/

!backend/.env.test.example
