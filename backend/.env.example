APP_NAME=粤教留学服务平台
ENVIRONMENT=dev
DEBUG=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=education
POSTGRES_USER=education
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_SCHEMA=public
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=120
FILE_STORAGE_ROOT=./storage
BUSINESS_TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL=60
TEST_DATABASE_ENABLED=false
# Test runner reads .env.test only; its database name MUST end with _test.
TRUSTED_PROXY_IPS=
LOGIN_RATE_LIMIT_PER_MINUTE=10
VISITOR_RATE_LIMIT_PER_MINUTE=20
DIFY_MODE=disabled
DIFY_BASE_URL=http://127.0.0.1
DIFY_VISITOR_KEY=
DIFY_ASSESSMENT_KEY=
DIFY_ENTERPRISE_KEY=
DIFY_STUDENT_KEY=
DIFY_REPORT_KEY=
AI_TIMEOUT_VISITOR_SECONDS=30
AI_TIMEOUT_ASSESSMENT_SECONDS=60
VISITOR_SESSION_TTL_MINUTES=60
ASSESSMENT_RECLAIM_AFTER_SECONDS=300
M5_AI_MODE=DISABLED
M5_AI_TIMEOUT=45
M5_DIFY_BASE_URL=
M5_DIFY_ASSISTANT_KEY=
M5_DIFY_REPORT_KEY=
SLA_FEEDBACK_HOURS=24
ASR_ENABLED=false
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
