# =============================================================
# 后端配置模板（复制成 .env 使用）
# =============================================================
# 用法：cp .env.example .env  然后按需修改
# ⚠️ .env 不要提交到 git

# ---- 应用 ----
APP_NAME=粤教留学服务平台
ENVIRONMENT=dev
DEBUG=true

# ---- 数据库（要和 deploy/docker-compose.yml 一致）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=edu_dev_2026
POSTGRES_DB=education
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- 安全（生产必须换！生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"）----
JWT_SECRET=dev-only-secret-please-change-in-production-0123456789abcdef
JWT_EXPIRE_MINUTES=120

# ---- Dify（后续接）----
DIFY_BASE_URL=http://localhost
DIFY_API_KEY=
